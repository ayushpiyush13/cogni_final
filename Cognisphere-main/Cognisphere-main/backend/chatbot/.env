#ai

# Copy this file to a file named .env and fill in your keys.
# The bot tries the providers below in order and switches automatically
# when one hits its free limit. More keys = fewer "busy" moments.

# 1) Groq (console.groq.com) - main brain, same key as your JARVIS project

GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# 2) Gemini (aistudio.google.com) - backup brain AND document search (embeddings)
GEMINI_API_KEY='AQ.Ab8RN6JO5wpVHQwiE24E5QCOiFSWixtToH_4qfsleLKe9FHqMw'
GEMINI_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001

# 3) Optional extra backup: OpenRouter free models (openrouter.ai)
OPENROUTER_API_KEY='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'
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# 4) Optional last resort, runs offline on your PC (leave empty to disable)
OLLAMA_MODEL=

# Live mandi prices: free key from data.gov.in (log in -> My Account -> API key)
DATA_GOV_API_KEY=
# Only change this if data.gov.in moves the dataset
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
